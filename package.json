{
  "name": "vinocss-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vinocss-build --workspace",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings",
    "line-width": "vinocss-line-width",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "review": "pnpm run check && pnpm build && pnpm line-width && pnpm test"
  },
  "devDependencies": {
    "@vinocss/devtools-build": "workspace:*",
    "@vinocss/devtools-line-width": "workspace:*",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "rolldown": "catalog:dev",
    "rolldown-plugin-dts": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
