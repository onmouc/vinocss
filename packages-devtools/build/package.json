{
  "name": "@vinocss/devtools-build",
  "version": "0.0.0",
  "bin": {
    "vinocss-build": "./bin/vinocss-build.js"
  },
  "files": [
    "bin",
    "out"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "import": "./out/index.js",
      "require": "./out/index.cjs"
    },
    "./package": {
      "types": "./out/package.d.ts",
      "import": "./out/package.js",
      "require": "./out/package.cjs"
    },
    "./workspace": {
      "types": "./out/workspace.d.ts",
      "import": "./out/workspace.js",
      "require": "./out/workspace.cjs"
    }
  },
  "scripts": {
    "build": "node --import @oxc-node/core/register src/main.ts --lib package,workspace",
    "build:self": "node --import @oxc-node/core/register src/main.ts --self --lib package,workspace",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "chalk": "catalog:dep",
    "commander": "catalog:dep",
    "rolldown": "catalog:dep",
    "rolldown-plugin-dts": "catalog:dep",
    "typescript": "catalog:dep"
  },
  "devDependencies": {
    "@oxc-node/core": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vinocss/devtools-tsconfig": "workspace:*",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
