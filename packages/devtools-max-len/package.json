{
  "name": "@vinocss/devtools-max-len",
  "version": "0.0.0",
  "description": "Reports any tracked line over the width limit.",
  "bin": {
    "vinocss-max-len": "./bin/vinocss-max-len.js"
  },
  "files": [
    "bin",
    "out"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "import": "./out/index.js",
      "require": "./out/index.cjs"
    }
  },
  "scripts": {
    "build": "vinocss-build",
    "build:self": "vinocss-build --self",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vinocss/utils-log": "workspace:*",
    "commander": "catalog:dep"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@vinocss/devtools-build": "workspace:*",
    "@vinocss/devtools-tsconfig": "workspace:*",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
