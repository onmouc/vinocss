{
  "name": "@vinocss/transform",
  "version": "0.0.0",
  "description": "Compiles style calls into plain JavaScript and extracted css.",
  "files": [
    "out"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "import": "./out/index.js",
      "require": "./out/index.cjs"
    }
  },
  "scripts": {
    "build": "vinocss-build",
    "build:self": "vinocss-build --self",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vinocss/utils-case": "workspace:*",
    "oxc-parser": "^0.152.0",
    "vinocss": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@vinocss/devtools-build": "workspace:*",
    "@vinocss/devtools-lines": "workspace:*",
    "@vinocss/devtools-tsconfig": "workspace:*",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
