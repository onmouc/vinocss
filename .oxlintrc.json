{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node", "jsdoc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "perf": "warn"
  },
  "rules": {
    "jsdoc/require-param": "off",
    "jsdoc/require-returns": "off",
    "no-console": "error"
  },
  "overrides": [
    {
      "files": ["**/src/main.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
