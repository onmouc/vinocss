{
  "name": "vinocss",
  "version": "0.0.0",
  "files": [
    "out"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "import": "./out/index.js",
      "require": "./out/index.cjs"
    },
    "./utils": {
      "types": "./out/utils.d.ts",
      "import": "./out/utils.js",
      "require": "./out/utils.cjs"
    }
  },
  "scripts": {
    "build": "vinocss-build --lib utils",
    "build:self": "vinocss-build --self --lib utils",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "csstype": "^3.2.3"
  },
  "devDependencies": {
    "@vinocss/devtools-build": "workspace:*",
    "@vinocss/devtools-tsconfig": "workspace:*"
  }
}
