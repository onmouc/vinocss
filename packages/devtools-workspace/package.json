{
  "name": "@vinocss/devtools-workspace",
  "version": "0.0.0",
  "description": "Detects a pnpm workspace and orders its packages for a build.",
  "files": [
    "out"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "import": "./out/index.js",
      "require": "./out/index.cjs"
    }
  },
  "scripts": {
    "build": "vinocss-build",
    "build:self": "vinocss-build --self",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@vinocss/devtools-build": "workspace:*",
    "@vinocss/devtools-tsconfig": "workspace:*"
  }
}
